<Window x:Class="VolumePie.Windows.PieOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VolumePie.Controls"
        Title="VolumePie Overlay"
        Width="600"
        Height="610"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FocusVisualStyle="{x:Null}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style TargetType="{x:Type Window}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="{x:Type controls:PieMenuCanvas}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="OverlayScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollBarThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                CornerRadius="3"
                                Background="#71717A"
                                Opacity="0.65"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#A1A1AA"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource OverlayScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource OverlayScrollBarThumb}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource OverlayScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootGrid"
              Width="600"
              Height="610"
              Background="Transparent"
              MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="1" CenterX="300" CenterY="320"/>
            </Grid.RenderTransform>

        <!-- Main Radial Pie Canvas centered at (300, 320) -->
        <controls:PieMenuCanvas x:Name="PieCanvas"
                                Width="540"
                                Height="540"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FocusVisualStyle="{x:Null}"
                                Margin="0,50,0,0" />

        <!-- Top Floating Device Switcher Bars (Output & Input) -->
        <StackPanel x:Name="TopDeviceBarsContainer"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
            <!-- Output Device Pill -->
            <Border x:Name="TopOutputDeviceBarBorder"
                    Background="#F018181B"
                    BorderBrush="#52525B"
                    BorderThickness="1.0"
                    CornerRadius="18"
                    Padding="3,2"
                    Margin="0,0,8,0"
                    MouseWheel="TopOutputDeviceBarBorder_MouseWheel"
                    ToolTip="{DynamicResource Loc_PieOutputDeviceBarTooltip}">
                <Button x:Name="BtnOutputDevice"
                        Click="BtnOutputDevice_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtOutputDeviceIcon"
                                   Text="🔊"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtOutputDeviceLabel"
                                   Text="{DynamicResource Loc_PieOutputDeviceLabel}"
                                   Foreground="#A1A1AA"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtOutputDeviceName"
                                   Text="スピーカー"
                                   Foreground="#F4F4F5"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   MaxWidth="125"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtOutputDeviceChevron"
                                   Text="▾"
                                   Foreground="#A1A1AA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="5,0,2,0"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Input Device Pill -->
            <Border x:Name="TopInputDeviceBarBorder"
                    Background="#F018181B"
                    BorderBrush="#52525B"
                    BorderThickness="1.0"
                    CornerRadius="18"
                    Padding="3,2"
                    MouseWheel="TopInputDeviceBarBorder_MouseWheel"
                    ToolTip="{DynamicResource Loc_PieInputDeviceBarTooltip}">
                <Button x:Name="BtnInputDevice"
                        Click="BtnInputDevice_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8,4"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtInputDeviceIcon"
                                   Text="🎤"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtInputDeviceLabel"
                                   Text="{DynamicResource Loc_PieInputDeviceLabel}"
                                   Foreground="#A1A1AA"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,4,0"/>
                        <TextBlock x:Name="TxtInputDeviceName"
                                   Text="マイク"
                                   Foreground="#F4F4F5"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   MaxWidth="125"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtInputDeviceChevron"
                                   Text="▾"
                                   Foreground="#A1A1AA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="5,0,2,0"/>
                    </StackPanel>
                </Button>
            </Border>
        </StackPanel>

        <!-- Windows 11 Style Audio Device Popup Card -->
        <Border x:Name="DevicePopupBorder"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,46,0,0"
                Width="400"
                MaxHeight="360"
                Background="#F71C1F26"
                BorderBrush="#52525B"
                BorderThickness="1.2"
                CornerRadius="14"
                Padding="10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Mode Tabs: [ 🔊 出力 ] and [ 🎤 入力 ] -->
                <Grid Grid.Row="0" Margin="4,2,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnPopupTabOutput"
                            Grid.Column="0"
                            Margin="0,0,3,0"
                            Click="BtnPopupTabOutput_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="8,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPopupTabOutputLabel"
                                       Text="{DynamicResource Loc_PieDevicePopupOutputTab}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnPopupTabInput"
                            Grid.Column="1"
                            Margin="3,0,0,0"
                            Click="BtnPopupTabInput_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TabBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="8,6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎤" Margin="0,0,6,0" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPopupTabInputLabel"
                                       Text="{DynamicResource Loc_PieDevicePopupInputTab}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <DockPanel Grid.Row="1" Margin="6,0,6,6">
                    <TextBlock x:Name="TxtDevicePopupHint"
                               Text="{DynamicResource Loc_PieDevicePopupHint}"
                               FontSize="11"
                               Foreground="#A1A1AA"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Scrollable Device List -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DeviceListPanel" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>
