<Window x:Class="VolumePie.Windows.PieOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VolumePie.Controls"
        Title="VolumePie Overlay"
        Width="600"
        Height="610"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FocusVisualStyle="{x:Null}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style TargetType="{x:Type Window}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="{x:Type controls:PieMenuCanvas}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="OverlayScrollBarPageButton" TargetType="RepeatButton">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollBarThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                CornerRadius="3"
                                Background="#71717A"
                                Opacity="0.65"
                                Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#A1A1AA"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource OverlayScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource OverlayScrollBarThumb}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource OverlayScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Grid x:Name="RootGrid"
              Width="600"
              Height="610"
              Background="Transparent"
              MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PopupScale" ScaleX="1" ScaleY="1" CenterX="300" CenterY="320"/>
            </Grid.RenderTransform>

        <!-- Main Radial Pie Canvas centered at (300, 320) -->
        <controls:PieMenuCanvas x:Name="PieCanvas"
                                Width="540"
                                Height="540"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                FocusVisualStyle="{x:Null}"
                                Margin="0,50,0,0" />

        <!-- Top Floating Output Device Switcher Pill -->
        <Border x:Name="TopDeviceBarBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,8,0,0"
                MaxWidth="520"
                Background="#F018181B"
                BorderBrush="#52525B"
                BorderThickness="1.0"
                CornerRadius="18"
                Padding="4,3"
                MouseWheel="TopDeviceBarBorder_MouseWheel"
                ToolTip="クリックで出力デバイス一覧を表示 / ホイール回転で即座に切替">
            <Button x:Name="BtnOutputDevice"
                    Click="BtnOutputDevice_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="10,4"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOutputDeviceIcon"
                               Text="🔊"
                               FontSize="13.5"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtOutputDeviceLabel"
                               Text="出力デバイス:"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtOutputDeviceName"
                               Text="スピーカー"
                               Foreground="#F4F4F5"
                               FontSize="13"
                               FontWeight="Bold"
                               MaxWidth="320"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtOutputDeviceChevron"
                               Text="▾"
                               Foreground="#A1A1AA"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="8,0,2,0"/>
                </StackPanel>
            </Button>
        </Border>

        <!-- Windows 11 Style Output Device Popup Card -->
        <Border x:Name="OutputDevicePopupBorder"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,50,0,0"
                Width="380"
                MaxHeight="340"
                Background="#F71C1F26"
                BorderBrush="#52525B"
                BorderThickness="1.2"
                CornerRadius="14"
                Padding="10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="6,2,6,8">
                    <TextBlock x:Name="TxtDevicePopupTitle"
                               Text="出力デバイス"
                               FontSize="12.5"
                               FontWeight="Bold"
                               Foreground="#F4F4F5"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDevicePopupHint"
                               Text="クリックで切替"
                               FontSize="11"
                               Foreground="#A1A1AA"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OutputDeviceListPanel" Orientation="Vertical"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
    </Viewbox>
</Window>
